#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56151e06f3e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56151e06f570 .scope module, "tb_pc" "tb_pc" 3 3;
 .timescale -9 -12;
v0x56151e08a060_0 .var "clk", 0 0;
v0x56151e08a120_0 .net "pc_current", 15 0, v0x56151e05cce0_0;  1 drivers
v0x56151e08a1c0_0 .var "pc_load", 0 0;
v0x56151e08a260_0 .var "pc_next", 15 0;
v0x56151e08a330_0 .var "rst_n", 0 0;
E_0x56151e06fa90 .event posedge, v0x56151e05b360_0;
S_0x56151e030490 .scope module, "uut" "program_counter" 3 9, 4 2 0, S_0x56151e06f570;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "pc_load";
    .port_info 3 /INPUT 16 "pc_next";
    .port_info 4 /OUTPUT 16 "pc_current";
v0x56151e05b360_0 .net "clk", 0 0, v0x56151e08a060_0;  1 drivers
v0x56151e05cce0_0 .var "pc_current", 15 0;
v0x56151e05dec0_0 .net "pc_load", 0 0, v0x56151e08a1c0_0;  1 drivers
v0x56151e089dd0_0 .net "pc_next", 15 0, v0x56151e08a260_0;  1 drivers
v0x56151e089eb0_0 .net "rst_n", 0 0, v0x56151e08a330_0;  1 drivers
E_0x56151e0707e0/0 .event negedge, v0x56151e089eb0_0;
E_0x56151e0707e0/1 .event posedge, v0x56151e05b360_0;
E_0x56151e0707e0 .event/or E_0x56151e0707e0/0, E_0x56151e0707e0/1;
    .scope S_0x56151e030490;
T_0 ;
    %wait E_0x56151e0707e0;
    %load/vec4 v0x56151e089eb0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 16;
    %assign/vec4 v0x56151e05cce0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x56151e05dec0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x56151e089dd0_0;
    %assign/vec4 v0x56151e05cce0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x56151e05cce0_0;
    %addi 1, 0, 16;
    %assign/vec4 v0x56151e05cce0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x56151e06f570;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x56151e08a060_0;
    %inv;
    %store/vec4 v0x56151e08a060_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x56151e06f570;
T_2 ;
    %vpi_call/w 3 21 "$dumpfile", "sim/tb_pc.vcd" {0 0 0};
    %vpi_call/w 3 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56151e06f570 {0 0 0};
    %vpi_call/w 3 24 "$display", "=== PC test start ===" {0 0 0};
    %vpi_call/w 3 25 "$display", "Block purpose: program counter stores current instruction address." {0 0 0};
    %vpi_call/w 3 26 "$display", "Signals: rst_n resets PC, pc_load loads jump target, pc_next is jump address." {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56151e08a060_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56151e08a330_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56151e08a1c0_0, 0, 1;
    %pushi/vec4 0, 0, 16;
    %store/vec4 v0x56151e08a260_0, 0, 16;
    %delay 1000, 0;
    %vpi_call/w 3 30 "$display", "[PC] reset active: rst_n=%b pc_load=%b pc_next=0x%04h pc_current=0x%04h", v0x56151e08a330_0, v0x56151e08a1c0_0, v0x56151e08a260_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 32 "$error", "Reset failed while reset is active" {0 0 0};
T_2.0 ;
    %delay 9000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56151e08a330_0, 0, 1;
    %delay 1000, 0;
    %vpi_call/w 3 36 "$display", "[PC] reset released: rst_n=%b pc_current=0x%04h", v0x56151e08a330_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 37 "$error", "PC changed too early after reset release" {0 0 0};
T_2.2 ;
    %wait E_0x56151e06fa90;
    %delay 1000, 0;
    %vpi_call/w 3 41 "$display", "[PC] increment step 1: pc_current=0x%04h (%0d)", v0x56151e08a120_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %pad/u 32;
    %cmpi/ne 1, 0, 32;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 42 "$error", "Increment failed" {0 0 0};
T_2.4 ;
    %wait E_0x56151e06fa90;
    %delay 1000, 0;
    %vpi_call/w 3 44 "$display", "[PC] increment step 2: pc_current=0x%04h (%0d)", v0x56151e08a120_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %pad/u 32;
    %cmpi/ne 2, 0, 32;
    %jmp/0xz  T_2.6, 6;
    %vpi_call/w 3 45 "$error", "Increment failed" {0 0 0};
T_2.6 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56151e08a1c0_0, 0, 1;
    %pushi/vec4 66, 0, 16;
    %store/vec4 v0x56151e08a260_0, 0, 16;
    %vpi_call/w 3 49 "$display", "[PC] request jump: pc_load=%b pc_next=0x%04h", v0x56151e08a1c0_0, v0x56151e08a260_0 {0 0 0};
    %wait E_0x56151e06fa90;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56151e08a1c0_0, 0, 1;
    %vpi_call/w 3 51 "$display", "[PC] after jump load: pc_current=0x%04h (%0d)", v0x56151e08a120_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %cmpi/ne 66, 0, 16;
    %jmp/0xz  T_2.8, 6;
    %vpi_call/w 3 52 "$error", "Jump load failed" {0 0 0};
T_2.8 ;
    %wait E_0x56151e06fa90;
    %delay 1000, 0;
    %vpi_call/w 3 56 "$display", "[PC] increment after jump: pc_current=0x%04h (%0d)", v0x56151e08a120_0, v0x56151e08a120_0 {0 0 0};
    %load/vec4 v0x56151e08a120_0;
    %cmpi/ne 67, 0, 16;
    %jmp/0xz  T_2.10, 6;
    %vpi_call/w 3 57 "$error", "Post-jump increment failed" {0 0 0};
T_2.10 ;
    %vpi_call/w 3 59 "$display", "PC tests completed." {0 0 0};
    %vpi_call/w 3 60 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_pc.v";
    "rtl/pc.v";
